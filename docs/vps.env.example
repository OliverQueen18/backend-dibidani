# Ajouter au .env du VPS (ne pas coller les secrets ERDV/PIE/Tontine).
# openssl rand -base64 48

DIBIDANI_TAG=latest
DIBIDANI_FRONTEND_TAG=latest
DIBIDANI_BACKEND_TAG=latest
DIBIDANI_HOST=dibidani.com
DIBIDANI_HOST_WWW=www.dibidani.com
DIBIDANI_PUBLIC_URL=https://dibidani.com
DIBIDANI_CORS_ORIGINS=https://dibidani.com,https://www.dibidani.com

# Fichiers (photos produits, originaux studio) — dossier hôte, relatif au compose VPS.
DIBIDANI_UPLOAD_HOST_PATH=./uploads/dibidani

DIBIDANI_DB=dibidani
DIBIDANI_DB_USER=dibidani
DIBIDANI_DB_PASS=change_me_strong_password

# Administrateur initial (créé au premier démarrage si l'e-mail n'existe pas).
DIBIDANI_ADMIN_EMAIL=admin@dibidani.com
DIBIDANI_ADMIN_PASSWORD=change_me_strong_admin_password
DIBIDANI_ADMIN_NAME=Administrateur Dibidani
DIBIDANI_ADMIN_PHONE=+223 70 00 00 00

# Minimum 32 octets.
DIBIDANI_JWT_SECRET=replace_with_at_least_32_random_bytes
DIBIDANI_PHOTO_STUDIO_TOKEN=replace_with_a_random_token
DIBIDANI_PHOTO_STUDIO_ENGINE=local
DIBIDANI_PHOTO_STUDIO_API_URL=

DIBIDANI_MAIL_HOST=smtp.gmail.com
DIBIDANI_MAIL_PORT=587
DIBIDANI_MAIL_FROM=
DIBIDANI_MAIL_FROM_NAME=Dibidani
# MAIL_USERNAME / MAIL_PASSWORD = SMTP_USER / SMTP_PASSWORD déjà présents

DIBIDANI_SMS_MOCK_ENABLED=true
DIBIDANI_SOCIAL_MOCK_ENABLED=false

DIBIDANI_SHOP_PHONE=+223 76 12 34 56
DIBIDANI_SHOP_WHATSAPP=+223 76 12 34 56
DIBIDANI_SHOP_EMAIL=contact@dibidani.com
DIBIDANI_SHOP_ADDRESS=Marché de Dibidani, Commune III
DIBIDANI_SHOP_OPENING_HOURS=Lun - Sam, 8h - 20h
